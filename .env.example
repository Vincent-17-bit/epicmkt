# EpicMKT: every environment variable, in one place. Copy the part you need; never commit real values.
# Where each block goes:
#   [functions]  Supabase Edge Function secrets:  supabase secrets set --env-file supabase/.env   (never in a browser build)
#   [scripts]    scripts/.env (read by `node --env-file=scripts/.env ...`)
#   [browser]    admin/.env, client/.env, seller/.env (VITE_* values are public by design: only the URL and the anon key)

# ---------------------------------------------------------------- [functions] Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. It bypasses row level security. It must never appear in a VITE_* variable or in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# development | staging | production. production turns on real SMS/e-mail and real OTP codes.
APP_ENV=development
# The browser origin allowed to call the functions, e.g. https://admin.epicmkt.app. Unset means "*" (development only).
ALLOWED_ORIGIN=

# ---------------------------------------------------------------- [vercel functions] Upstash Redis (optional)
# One shared copy of the browse and products snapshots for every Vercel instance. Unset means each instance asks Supabase itself.
# Server only. Set in Vercel > Settings > Environment Variables, never as a VITE_* variable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- [functions] Messaging (mock mode)
# mock = nothing is sent, the message log still fills in (ids "mock-...", costs estimated). live = real providers.
# Leave empty to follow APP_ENV: live in production, mock everywhere else.
MESSAGING_MODE=
# Africa's Talking SMS. AT_USERNAME=sandbox uses the sandbox host. AT_SENDER is optional (your approved sender ID).
AT_API_KEY=
AT_USERNAME=
AT_SENDER=
# Resend e-mail. MAIL_FROM looks like: EpicMKT <no-reply@yourdomain>
RESEND_API_KEY=
MAIL_FROM=
# Where applicant activity alerts are sent.
ADMIN_EMAIL=

# ---------------------------------------------------------------- [functions] Abuse protection
# Long random string. Salts the stored IP hashes (audit log, applications, logins). Changing it breaks old hashes.
IP_HASH_SALT=
# Cloudflare Turnstile secret for the public forms. Empty is accepted outside production.
TURNSTILE_SECRET=
# Shared secret that scheduled jobs (proofs purge, daily lifecycle) send. Long and random.
CRON_SECRET=

# ---------------------------------------------------------------- [functions] M-Pesa Paybill (automatic payments)
# Long random string. Safaricom posts payments to <SUPABASE_URL>/functions/v1/pay-callback/<this value>/confirmation.
# Anyone who knows it can post fake payments, so keep it secret and make it unguessable.
MPESA_CALLBACK_SECRET=

# ---------------------------------------------------------------- [scripts]
# Direct Postgres connection string, used only by `npm run seed:admin` and the database tests.
# Supabase: Project settings > Database > Connection string (URI). Local: postgres://postgres:postgres@127.0.0.1:5432/postgres
SEED_DATABASE_URL=
# Used by `npm run seed` and `npm run seed:sellers` (supabase-js with the service role key).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above are reused.
# `npm run test:db` connects to TEST_DATABASE_URL (default postgres://postgres:postgres@127.0.0.1:5432/postgres)
# and creates, then drops, a database named epicmkt_test.
TEST_DATABASE_URL=
# Used by scripts/seed-admin.mjs to print the SQL that makes you the first owner.
ADMIN_NAME=

# ---------------------------------------------------------------- [browser] public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional, client/.env. Product pictures load as smaller copies (needs Supabase image transformations, a paid plan).
VITE_IMAGE_TRANSFORMS=false
# Optional, client/.env. Comma-separated CDN or mirror origins that serve the seller-media bucket at <host>/<path>.
# Pictures are spread across them by a hash of the path. Leave empty to use the Supabase bucket directly.
VITE_MEDIA_HOSTS=
VITE_TURNSTILE_SITE_KEY=
# Public contact details shown on the marketing site.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_TOWN=
VITE_SUPPORT_HOURS=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_X=
VITE_SELLER_URL=/seller/
# Seller app: mock (in-browser demo data) or live. The admin app is in mock mode while VITE_SUPABASE_URL is empty.
VITE_API_MODE=mock

# ---------------------------------------------------------------- [scripts] M-Pesa (scripts/register-mpesa-c2b.mjs)
# sandbox | production. Keys come from the Safaricom Daraja portal. MPESA_CALLBACK_SECRET must match the functions block.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Your Paybill business number.
MPESA_SHORTCODE=
