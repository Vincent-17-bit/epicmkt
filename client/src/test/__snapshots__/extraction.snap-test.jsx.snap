            </span>
            <select
              aria-invalid="false"
              class="input"
            >
              <option
                value=""
              >
                Choose a reason
              </option>
              <option
                value="wrong-info"
              >
                Wrong or outdated information
              </option>
              <option
                value="closed"
              >
                Business has closed or moved
              </option>
              <option
                value="wrong-contact"
              >
                Phone or WhatsApp does not work
              </option>
              <option
                value="scam"
              >
                Scam or misleading
              </option>
              <option
                value="inappropriate"
              >
                Inappropriate content
              </option>
              <option
                value="other"
              >
                Something else
              </option>
