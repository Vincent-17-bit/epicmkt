            class="field"
          >
            <span
              class="label"
            >
              Details (optional)
            </span>
            <textarea
              aria-invalid="false"
              class="input"
              maxlength="500"
              rows="4"
            />
          </label>
          <label
            class="field"
          >
            <span
              class="label"
            >
              Your phone or email (optional)
            </span>
            <input
              aria-invalid="false"
              class="input"
              maxlength="80"
              value=""
            />
          </label>
