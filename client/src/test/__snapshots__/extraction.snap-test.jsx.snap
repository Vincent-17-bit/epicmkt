              class="btn secondary undefined "
              type="button"
            >
              <span>
                Cancel
              </span>
            </button>
            <button
              class="btn primary undefined "
              type="submit"
            >
              <span>
                Send report
              </span>
            </button>
          </div>
        </form>
      </dialog>
    </article>
  </div>
</div>
`;

