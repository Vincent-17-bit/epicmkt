          <label
            class="field"
          >
            <span
              class="label"
            >
              Details (optional)
            </span>
            <textarea
              aria-invalid="false"
              class="input"
              maxlength="500"
              rows="4"
            />
          </label>
          <label
            class="field"
          >
            <span
              class="label"
            >
              Your phone or email (optional)
            </span>
            <input
              aria-invalid="false"
              class="input"
              maxlength="80"
              value=""
            />
          </label>
          <div
            class="actions"
          >
            <button
              class="btn secondary undefined "
              type="button"
            >
              <span>
                Cancel
              </span>
            </button>
            <button
              class="btn primary undefined "
              type="submit"
            >
              <span>
                Send report
              </span>
            </button>
          </div>
        </form>
      </dialog>
    </article>
  </div>
</div>
`;

