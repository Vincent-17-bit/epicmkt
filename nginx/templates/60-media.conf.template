server {
    include /etc/nginx/snippets/listen.conf;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/guard.conf;
    server_name ${MEDIA_DOMAIN};
    set $up_host ${SUPABASE_HOST};

    location / {
        limit_req zone=rl_media burst=400 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/cache.conf;
        include /etc/nginx/snippets/headers.conf;
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        proxy_cache media;
        proxy_cache_valid 200 30d;
        proxy_pass https://supabase_storage/storage/v1/object/public/seller-media/;
    }
}
