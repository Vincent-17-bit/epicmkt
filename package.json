{
  "name": "epicmkt",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "ui",
    "backend",
    "admin-backend",
    "client",
    "seller",
    "admin"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:seller": "npm run dev -w seller",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w client && npm run build -w seller && npm run build -w admin",
    "test:api": "node backend/check.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "seed": "node --env-file=scripts/.env scripts/seed.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "migrate:images": "node --env-file=scripts/.env scripts/migrate-images-to-cloudinary.mjs",
    "test:tz": "node scripts/test-tz.mjs",
    "seed:sellers": "node --env-file=scripts/.env scripts/seed-sellers.mjs",
    "test:shared": "node --test \"shared/src/**/*.test.js\" \"scripts/*.test.mjs\" \"seller/src/{api,lib}/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"supabase/tests/*.test.mjs\"",
    "test:fn": "deno test --no-check -A --node-modules-dir=none --ignore=\"supabase/tests/*-db.test.ts\" \"supabase/tests/*.test.ts\"",
    "test:fn:db": "deno test --no-check -A --node-modules-dir=none \"supabase/tests/*-db.test.ts\"",
    "test:seller-backend": "npm run check:migrations && npm run sync:shared -- --check && npm run test:shared && npm run test:db && npm run test:fn && npm run test:fn:db",
    "test:seller-ui": "npm test -w seller",
    "test:client": "npm test -w client",
    "test:all": "npm run test:seller-backend && npm run test:seller-ui && npm run test:client && npm run test:admin-ui && npm run test:ui",
    "seed:admin": "node --env-file=scripts/.env scripts/seed.ts",
    "test:admin-backend": "npm run test:fn && npm run test:db",
    "test:admin-ui": "npm test -w admin",
    "lint:ui": "eslint ui/src",
    "test:visual": "node scripts/visual.mjs run",
    "test:ui": "npm test -w ui"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0"
  }
}
