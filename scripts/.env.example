# Read by: node --env-file=scripts/.env scripts/<name>
# npm run seed / seed:sellers (supabase-js, service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# npm run seed:admin (direct Postgres connection; Supabase: Project settings > Database > Connection string)
SEED_DATABASE_URL=
# scripts/seed-admin.mjs
ADMIN_EMAIL=
ADMIN_NAME=
# The seed refuses to run when this is production.
APP_ENV=development
